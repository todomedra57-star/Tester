      { "key": "sage", "name": { "ar": "أخضر مريمية", "en": "Sage" },
        "values": { "hero": "#2F3B32", "onHero": "#F4F3EE", "accent": "#A88B57", "bg": "#EDEFE8", "text": "#1E2620", "muted": "#66705F", "card": "#FBFBF8", "line": "#D4D9CC" } }
